{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "npm run db:start && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:start": "docker start portfolio-postgres || docker run -d --name portfolio-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=portfolio -p 5433:5432 pgvector/pgvector:pg16",
    "db:stop": "docker stop portfolio-postgres",
    "db:setup": "docker exec portfolio-postgres psql -U postgres -d portfolio -f - < db/schema.sql && npm run db:embed",
    "db:embed": "export $(grep -v '^#' .env | xargs) && npx tsx scripts/embed-content.ts",
    "save": "git add -A && git commit -m 'Save progress' && git log -1 --oneline"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "next": "^14.2.0",
    "openai": "^6.16.0",
    "pg": "^8.16.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
